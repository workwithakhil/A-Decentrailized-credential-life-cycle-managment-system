# Optional overrides for the frontend build.
#
# Every VITE_ variable is baked into the PUBLIC JavaScript bundle that anyone
# can download. Never put a private key, API key, JWT or token here — the build
# refuses to run if it detects one. Keys belong only in the root .env, which is
# used by Hardhat scripts and never reaches the browser.
#
# Public RPC URL only (no API key in the path or query string).
VITE_CHAIN_ID=
VITE_RPC_URL=
